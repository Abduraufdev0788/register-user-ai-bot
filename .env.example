# Telegram API sozlamalari (https://my.telegram.org dan olinadi)
API_ID=37290229
API_HASH=ea184dce4f121a8f079a521a967d5cd9

# Shaxsiy Telegram hisobingiz telefon raqami (masalan: +998901234567)
# Agar bo'sh qoldirsangiz, terminalda birinchi marta kiritishingizni so'raydi
PHONE_NUMBER=

# Sessiya nomi va sozlamalar
SESSION_NAME=user_session
ONLY_PRIVATE=true

# Google Gemini API kaliti (https://aistudio.google.com dan olinadi)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini modeli
GEMINI_MODEL=gemini-3.5-flash

# Google Sheets Webhook URL (Google Apps Script orqali)
# Qanday olish bo'yicha ko'rsatma README.md da keltirilgan
GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/AKfycbx.../exec

